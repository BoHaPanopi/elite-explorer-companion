{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Old Guy of Grumpy",
  "version": "0.1.2",
  "identifier": "de.panopi.eliteexplorercompanion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cmd /c src\\tools\\ogg-voice\\BUILD_OGG_STIMME.bat && npm run dev",
    "beforeBuildCommand": "cmd /c src\\tools\\ogg-voice\\BUILD_OGG_STIMME.bat && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Old Guy of Grumpy",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ogg-voice-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
