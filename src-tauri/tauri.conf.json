{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Old Guy of Grumpy",
  "version": "0.14.0",
  "identifier": "de.panopi.eliteexplorercompanion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cmd /c src\\tools\\ogg-voice\\BUILD_OGG_STIMME.bat && npm run dev",
    "beforeBuildCommand": "cmd /c src\\tools\\ogg-voice\\BUILD_OGG_STIMME.bat && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Old Guy of Grumpy",
        "width": 1400,
        "height": 900,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/ogg-voice-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MTNGQTZBMDYxRDFBM0YKUldRL0doMEdhdm9UWnlRLzRZbk45MHF6cThrZUNOeFFHS3ljaEo1MUp3dWlTNStEMmFEYk1yOWIK",
      "endpoints": [
        "https://github.com/BoHaPanopi/elite-explorer-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
